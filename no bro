		-- Input direction helper
		local function GetMoveVector()
			local UIS = game.UserInputService
			local move = Vector3.new(0,0,0)

			if UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up)    then move += Vector3.new( 0,0,-1) end
			if UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.Down)  then move += Vector3.new( 0,0, 1) end
			if UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.Left)  then move += Vector3.new(-1,0, 0) end
			if UIS:IsKeyDown(Enum.KeyCode.D) or UIS:IsKeyDown(Enum.KeyCode.Right) then move += Vector3.new( 1,0, 0) end

			-- Gamepad (optional – remove if you only care about keyboard)
			for _, gp in UIS:GetConnectedGamepads() do
				for _, i in UIS:GetGamepadState(gp) do
					if i.KeyCode == Enum.KeyCode.Thumbstick1 then
						move += Vector3.new(i.Position.X, 0, -i.Position.Y)
						break
					end
				end
			end

			local m = move.Magnitude
			return m > 1 and move/m or (m < 0.01 and Vector3.zero or move)
		end

		local function getInputDirection()
			local move = GetMoveVector()
			if move.X == 0 and move.Z == 0 then
				return 0, 0
			end
			local angle = math.atan2(move.Z, move.X)
			local x = math.cos(angle)
			local z = math.sin(angle)
			if math.abs(x) < 0.001 then x = 0 end
			if math.abs(z) < 0.001 then z = 0 end
			return x, z
		end

