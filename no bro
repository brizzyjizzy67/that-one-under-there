	function antilag()
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local script = game.Players.LocalPlayer.PlayerScripts.CharacterAndBeamMove
		local Players = game:GetService("Players")
		local TweenService = game:GetService("TweenService")
		local RunService = game:GetService("RunService")
		local ReplicatedFirst = game:GetService("ReplicatedFirst")

		local LocalPlayer = Players.LocalPlayer
		local LookEvent = ReplicatedStorage.CharacterEvents.Look
		local CurrentCamera = workspace.CurrentCamera

		local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
		local torso = character:WaitForChild("Torso")
		local hrp = character:WaitForChild("HumanoidRootPart")
		local neck = torso:WaitForChild("Neck")
		local humanoid = character:WaitForChild("Humanoid")
		local rootJoint = hrp:WaitForChild("RootJoint")
		local rightShoulder = torso:WaitForChild("Right Shoulder")

		local grabAnim = script:WaitForChild("GrabAnimation")
		local animator = humanoid:WaitForChild("Animator")
		local grabTrack = animator:LoadAnimation(grabAnim)

		local defaultNeckC0 = neck.C0
		local neckYOffset = neck.C0.Y

		-- Character respawn handling
		LocalPlayer.CharacterAdded:Connect(function(newChar)
			character = newChar
			torso = newChar:WaitForChild("Torso")
			hrp = newChar:WaitForChild("HumanoidRootPart")
			neck = torso:WaitForChild("Neck")
			humanoid = newChar:WaitForChild("Humanoid")
			rootJoint = hrp:WaitForChild("RootJoint")
			rightShoulder = torso:WaitForChild("Right Shoulder")
			
			neckYOffset = neck.C0.Y
			defaultNeckC0 = neck.C0
			
			animator = humanoid:WaitForChild("Animator")
			grabTrack = animator:LoadAnimation(grabAnim)
		end)

		LocalPlayer.CharacterRemoving:Connect(function()
			character = nil
			torso = nil
			hrp = nil
			neck = nil
			humanoid = nil
			rootJoint = nil
			rightShoulder = nil
			animator = nil
			grabTrack = nil
		end)

		-- Head tracking / look system (server sync)
		LookEvent.OnClientEvent:Connect(function(player, neckC0, rootC0, shoulderC0, priority)
			if not player or not player.Character then return end
			
			local char = player.Character
			local t = char:FindFirstChild("Torso")
			if not t then return end
			
			local n = t:FindFirstChild("Neck")
			local rj = char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart:FindFirstChild("RootJoint")
			local rs = t:FindFirstChild("Right Shoulder")
			
			if not n or not rj then return end
			
			local ti = TweenInfo.new(1, Enum.EasingStyle.Linear)
			
			if priority == "high" then
				ti = TweenInfo.new(0.1, Enum.EasingStyle.Linear)
			elseif priority == "medium" then
				ti = TweenInfo.new(0.5, Enum.EasingStyle.Linear)
			elseif priority == "low" or priority == "lowest" then
				ti = TweenInfo.new(0.25, Enum.EasingStyle.Linear)
			end
			
			TweenService:Create(n, ti, {C0 = neckC0}):Play()
			TweenService:Create(rj, ti, {C0 = rootC0}):Play()
			
			if shoulderC0 and rs then
				shoulderC0 = CFrame.new(shoulderC0.X * (Sizelist[player.UserId] or 1), shoulderC0.Y * (Sizelist[player.UserId] or 1), shoulderC0.Z) * shoulderC0.Rotation
				TweenService:Create(rs, ti, {C0 = shoulderC0}):Play()
			end
		end)

		-- Grab line visuals (for other players)
		local lowQuality = false
		script.LowQualityMode.Event:Connect(function()
			lowQuality = true
		end)

		local linelist = {}

		ReplicatedStorage.GrabEvents.CreateGrabLine.OnClientEvent:Connect(function(player, targetPart, offset)
			if player == LocalPlayer then
				return
			end
			linelist[player.UserId] = {targetPart, offset, linelist[player.UserId] and linelist[player.UserId][3] + 1 or 1}
		end)

		local alertlist = {}

		RunService.RenderStepped:Connect(function(dt)
			for _,player in pairs(game.Players:GetPlayers()) do
				if linelist[player.UserId] then
					task.spawn(function()
						targetPart, offset, times = unpack(linelist[player.UserId])
						linelist[player.UserId] = nil
						if times * dt > 2 then
							if player.Character and player.Character:FindFirstChild("GrabParts") then
								player.Character.GrabParts:Destroy()
							end
							if not alertlist[player.UserId] then
								alertlist[player.UserId] = true
								game.TextChatService.TextChannels.RBXSystem:DisplaySystemMessage("<font color='#d300c1'>「</font><font color='#ff00ea'>BinisJ</font><font color='#d300c1'>」</font><font color='#ff00ea'>"..player.DisplayName.." (@"..player.Name..") is lagging the server</font>")
								OrionLib:MakeNotification({
									Name = "Anti-Lag",
									Content = player.DisplayName.." (@"..player.Name..") is lagging the server",
									Image = "rbxassetid://4483345998",
									Time = 2
								})
								task.wait(10)
								alertlist[player.UserId] = nil
							end
						elseif targetPart and offset then
							if not player.Character then return end
							
							local existing = player.Character:FindFirstChild("GrabParts")
							if existing then existing:Destroy() end
							
							local template = ReplicatedFirst:WaitForChild("GrabParts")
							local grabParts = template:Clone()
							grabParts:ScaleTo(Sizelist[player.UserId] or 1)
							
							local beamColor = player:WaitForChild("BeamColor")
							local color = beamColor:WaitForChild("BallColorHolder").Value
							local seq = beamColor:WaitForChild("ColorSequenceHolder").Color
							
							local pos = (targetPart.CFrame * offset).Position
							
							if lowQuality then
								grabParts.GrabPart.LowQualityGrabPartBall.Transparency = 0
								grabParts.GrabPart.Transparency = 1
								grabParts.BeamPart.GrabBeam.Segments = 20
							end
							
							local farther = player:FindFirstChild("FartherReach")
							if farther and farther.Value then
								grabParts.BeamPart.GrabBeam.Texture = "rbxassetid://8933355899"
							end
							
							for _, v in grabParts:GetDescendants() do
								if v:IsA("BasePart") then
									v.Color = color
								elseif v:IsA("Beam") then
									v.Color = seq
								end
							end
							
							grabParts.DragPart.AlignOrientation:Destroy()
							grabParts.DragPart.AlignPosition:Destroy()
							
							local head = player.Character:WaitForChild("Head", 5)
							if not head then grabParts:Destroy() return end
							
							grabParts.DragPart.WeldConstraint.Part0 = grabParts.DragPart
							grabParts.DragPart.WeldConstraint.Part1 = head
							grabParts.DragPart.Position = head.Position + head.CFrame.LookVector * 10
							
							grabParts.BeamPart.GrabBeam.Attachment0 = player.Character:WaitForChild("Right Arm"):WaitForChild("RightGripAttachment")
							grabParts.BeamPart.Position = pos
							grabParts.GrabPart.WeldConstraint.Part1 = targetPart
							grabParts.GrabPart.Position = pos
							
							grabParts.Parent = player.Character
							
							grabParts.GrabPart.AttachSound:Play()
							grabParts.GrabPart.BeamSound:Play()
							
							local bodyFront = player.Character.Torso:WaitForChild("BodyFrontAttachment")
							
							local conn
							conn = RunService.RenderStepped:Connect(function()
								if not grabParts:IsDescendantOf(workspace) then
									conn:Disconnect()
									return
								end
								
								grabParts.BeamPart.CFrame = CFrame.lookAt(
									grabParts.GrabPart.Position,
									grabParts.DragPart.Position,
									Vector3.new(0,0,1)
								)
								
								grabParts.DragPart.DragAttach.WorldOrientation = bodyFront.WorldOrientation
								
								local dist = (grabParts.GrabPart.Position - grabParts.DragPart.Position).Magnitude
								grabParts.BeamPart.GrabBeam.CurveSize1 = dist * 1.5
								grabParts.GrabPart.BeamSound.PlaybackSpeed = dist / 2 + 2.5
							end)
							
							grabParts.AncestryChanged:Connect(function()
								if not grabParts:IsDescendantOf(workspace) then
									conn:Disconnect()
								end
							end)
						end
					end)
				end
			end
		end)

		ReplicatedStorage.GrabEvents.ExtendGrabLine.OnClientEvent:Connect(function(player, distance)
			if player == LocalPlayer then return end
			if type(distance) ~= "number" then return end
			local gp = player.Character and player.Character:FindFirstChild("GrabParts")
			if gp then
				local head = player.Character:FindFirstChild("Head")
