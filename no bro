    local function time()
        return os.time() + (os.clock() % 1)
    end

    thisuser.accHistory = thisuser.accHistory or {}
    thisuser.timesInjected = thisuser.timesInjected or 0
    thisuser.timesInjected += 1
    thisuser.uAgent = useragent
    thisuser.timeTotal = thisuser.timeTotal or 0
    thisuser.timeMax = thisuser.timeMax or 0
    thisuser.savedToys = thisuser.savedToys or {}
