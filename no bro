				end
			end

			if not ownershipped and game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
				local prt = itm:FindFirstChild("SoundPart") or itm:FindFirstChild("HumanoidRootPart") or itm:FindFirstChild("Main") or itm:FindFirstChild("Balloon")
				if prt and (prt.CFrame.Position - game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame.Position).Magnitude < 30 then
					SetNetworkOwner:FireServer(prt, CFrame.lookAt(game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame.Position,prt.CFrame.Position))
				else
					endGrab("nobris")
				end
			end

			local targetPos = camera.CFrame.Position + game.Players.LocalPlayer:GetMouse().UnitRay.Direction * currentDistance

			currentGrabPart.DragPart.Position = targetPos
			currentGrabPart.DragPart.DragAttach.WorldOrientation = orientAtt.WorldOrientation

			currentGrabPart.BeamPart.CFrame = CFrame.lookAt(
				currentGrabPart.GrabPart.Position,
				targetPos,
				Vector3.new(0,0,1)
			)

			local beamLen = (currentGrabPart.GrabPart.Position - targetPos).Magnitude
			local curve = beamLen * 1.5

			currentGrabPart.BeamPart.GrabBeam.CurveSize1 = curve
			currentGrabPart.GrabPart.BeamSound.PlaybackSpeed = curve / 2 + 2.5

			if not grabbedObject:IsDescendantOf(workspace) then
				endGrab("object gone")
			end
		end

		local function throw(_, state)
			if state ~= Enum.UserInputState.Begin then return end
			if not holdingGrab or not holdingScroll then return Enum.ContextActionResult.Pass end

			local obj = grabbedObject
			endGrab("throw")

			if obj.Anchored then return end

			local model = obj.Parent

			if model:IsA("Model") and model ~= workspace then
				for _, p in model:GetDescendants() do
					if p:IsA("BasePart") and not p.Anchored then
						p.Velocity = game.Players.LocalPlayer:GetMouse().UnitRay.Direction * FSR
					end
				end
			else
				obj.Velocity = game.Players.LocalPlayer:GetMouse().UnitRay.Direction * FSR
			end
		end

		local function changeDistanceScroll(_, _, input)
			if not holdingGrab or holdingScroll then return Enum.ContextActionResult.Pass end

			local delta = input.Position.Z
			if delta == 0 then return end

			local step = delta * SSM
			local newDist

			if step > 0 then
				newDist = currentDistance + step
				if newDist > IXE then
					newDist = IXE
				end
			else
				newDist = currentDistance + step
				if newDist < 3 then
					newDist = 3
				end
			end

			currentDistance = newDist
			ExtendGrabLine:FireServer(newDist)
		end

		local function zoomInOutToggle(name, state)
			if state == Enum.UserInputState.Begin then
				if name == "ZoomIn" then
					-- zoom in = decrease distance
					RS:BindToRenderStep("buttonDistanceMoving", 200, function()
						if currentDistance > 3 then
							currentDistance = math.max(3, math.floor(currentDistance - 1))
							ExtendGrabLine:FireServer(currentDistance)
						end
					end)
				elseif name == "ZoomOut" then
					-- zoom out = increase distance
					RS:BindToRenderStep("buttonDistanceMoving", 200, function()
						if currentDistance < IXE then
							currentDistance = math.min(IXE, math.ceil(currentDistance + 1))
							ExtendGrabLine:FireServer(currentDistance)
						end
					end)
				end
			else
				RS:UnbindFromRenderStep("buttonDistanceMoving")
			end
		end

