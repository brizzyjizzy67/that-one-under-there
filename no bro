if not _G.CantInject then
    _G.CantInject = true
    local ok, decoded = pcall(function()
        return game.HttpService:JSONDecode(readfile("BinisJ/SavedData.json"))
    end)
    local file = (ok and decoded) or {}
    
    local useragent = file.uAgent or "diddynigga"
    file.uAgent = useragent
	file.savedPlayers = file.savedPlayers or {}
    file.badboylist = file.badboylist or {}

