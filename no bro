					local function RunFriendScan(uid)
						friendTask = nil
						FriendsHeader.Text = "Bad Friends"
						FriendsList.Text   = "Loading..."

						local thisTask = {}
						friendTask = thisTask

						task.spawn(function()
							local friendCount = 0
							local lines = {}

							local ok, friendPages = pcall(function()
								return game.Players:GetFriendsAsync(uid)
							end)

							if not ok then
								if friendTask == thisTask then
									FriendsList.Text = "<font color=\"rgb(200,80,80)\">Failed to load friends.</font>"
								end
								return
							end

							while true do
								if friendTask ~= thisTask then return end

								local currentPage = friendPages:GetCurrentPage()
								for _, friendInfo in ipairs(currentPage) do
									if friendTask ~= thisTask then return end

									friendCount += 1
									local inGame = game.Players:GetPlayerByUserId(friendInfo.Id)

									if inGame then
										table.insert(lines, "<font color=\"rgb(100,210,100)\">[In Game] " .. inGame.DisplayName .. " (@" .. inGame.Name .. ")</font>")
									elseif inbadboylist(friendInfo.Id) then
										local d, u = getOfflinePlayerData(friendInfo.Id)
										table.insert(lines, "<font color=\"rgb(200,80,80)\">[Offline] " .. d .. " (@" .. u .. ") UserId: " .. friendInfo.Id .. "</font>")
									end
								end

								FriendsHeader.Text = "Bad Friends  " .. friendCount
								FriendsList.Text   = #lines > 0 and table.concat(lines, "\n") or "Loading..."

								if friendPages.IsFinished then break end
								friendPages:AdvanceToNextPageAsync()
							end

							if friendTask == thisTask then
								FriendsHeader.Text = "Bad Friends  " .. friendCount
								FriendsList.Text   = #lines > 0 and table.concat(lines, "\n") or "No flagged friends found."
							end
						end)
