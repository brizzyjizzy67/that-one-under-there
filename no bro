		local function tryGrab(_, state)
			if state ~= Enum.UserInputState.Begin then return end
			if player.Character.Humanoid.Health <= 0 then return end

			if holdingGrab then
				endGrab("double tap")
				return
			end

			local result = RaycastModule:Raycast()
			if not result or not result.Instance then return end

			local hit = result.Instance
			local hitPos = result.Position

			if not hit or hit.Anchored == nil then return end   -- filter out non-physical parts

			holdingGrab = true
			CrosshairsFrame.Size = UDim2.new(0,7,0,7)
			GrabNotify:Fire(true)
			CASButtonModule.ChangeColor("Grab", Color3.new(0,1,1))

			CASButtonModule.PlaceButton("Throw", throw)
			CASButtonModule.PlaceButton("ZoomIn",  zoomInOutToggle)
			CASButtonModule.PlaceButton("ZoomOut", zoomInOutToggle)
			CASButtonModule.PlaceButton("ZoomPC",  changeDistanceScroll)
			CASButtonModule.PlaceButton("Rotate",  toggleRotate)

			ActionEvent:Fire("GrabbingControls", true)
			ActionEvent:Fire("GrabControls",     false)

			currentDistance = (camera.CFrame.Position - hitPos).Magnitude

			grabbedObject = hit
			itm = grabbedObject.Parent

			if ncg then
				if not grabbedObject:FindFirstAncestor("Plots") and not grabbedObject:FindFirstAncestor("Slots") and (not grabbedObject:FindFirstAncestor("Map") or grabbedObject:FindFirstAncestor("AlwaysHereTweenedObjects")) then
					ncgo = obj
					for _,prt in pairs(obj:GetChildren()) do
						if prt:IsA("BasePart") then
							prt:SetAttribute("CanCollide",prt.CanCollide)
							prt.CanCollide = false
						end
					end
				else
					print("clippy bris")
				end
			end

			local grabClone = grabPartsTemplate:Clone()
			currentGrabPart = grabClone

			if lowQualityMode then
				grabClone.GrabPart.LowQualityGrabPartBall.Transparency = 0
				grabClone.GrabPart.Transparency = 1
				grabClone.BeamPart.GrabBeam.Segments = 30
			end

			grabClone.DragPart.Position = camera.CFrame.LookVector * currentDistance + camera.CFrame.Position

			-- visual
			local beamColor = player:WaitForChild("BeamColor")
			local farReach  = player:FindFirstChild("FartherReach")

			if farReach and farReach.Value then
				grabClone.BeamPart.GrabBeam.Texture = "rbxassetid://8933355899"
			end

			for _, d in grabClone:GetDescendants() do
				if d:IsA("BasePart") then
					d.Color = beamColor.BallColorHolder.Value
				elseif d:IsA("Beam") then
					d.Color = beamColor.ColorSequenceHolder.Color
				end
			end

			-- physics init
			if not hit.Anchored then
				hit.AssemblyLinearVelocity = player.Character.Head.AssemblyLinearVelocity
				hit.AssemblyAngularVelocity = Vector3.zero

				if FG and not hit:FindFirstAncestor("Plots") and not hit:FindFirstAncestor("Slots") and not hit:FindFirstAncestor("Map") then
					task.spawn(function()
						repeat
							game.RunService.Heartbeat:Wait()
							local ussy = hit.AssemblyLinearVelocity
							
							hit.AssemblyLinearVelocity = hit.AssemblyLinearVelocity * 100000

							game.RunService.RenderStepped:Wait()
							if hit then
								hit.AssemblyLinearVelocity = ussy
							end
						until not FG or not hit
					end)
				end
			end

			grabClone.DragPart.Anchored = true
			grabClone.GrabPart.GrabAttach.Orientation = orientAtt.WorldOrientation
			grabClone.DragPart.DragAttach.WorldOrientation = orientAtt.WorldOrientation
			grabClone.GrabPart.WeldConstraint.Part1 = hit
			grabClone.GrabPart.Position = hitPos
			grabClone.GrabPart.Anchored = false
			grabClone.BeamPart.Anchored = true
			grabClone.BeamPart.GrabBeam.Attachment0 = camAtt

			grabClone.Parent = workspace

			SetNetworkOwner:FireServer(hit, CFrame.lookAt(game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame.Position,hit.CFrame.Position))
			CreateGrabLine:FireServer(hit, hit.CFrame:Inverse() * hitPos)
			ExtendGrabLine:FireServer(currentDistance)
			rotateOffset = CFrame.new(0,0,0)
			RS:BindToRenderStep("dragBinding", Enum.RenderPriority.First.Value, updateDrag)

			grabClone.GrabPart.AttachSound:Play()
			task.wait()
			if grabClone:FindFirstChild("GrabPart") then
				grabClone.GrabPart.BeamSound:Play()
			end
		end

