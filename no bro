				local extraAngle = 0
				
				if x ~= 0 or z ~= 0 then
					local deg = math.deg(math.atan2(-z, -x)) - 90
					if math.abs(deg) > 90 then deg -= 180 end
					extraAngle = deg
					lastAngle = deg
				else
					if lastAngle < 0 then
						lastAngle = math.min(lastAngle + 10, 0)
					elseif lastAngle > 0 then
						lastAngle = math.max(lastAngle - 10, 0)
					end
					extraAngle = lastAngle
				end
				
				local neckCF = baseNeck
					* CFrame.Angles(0, math.rad(extraAngle) * look.Y * 0.8, 0)
					* CFrame.Angles(0, 0, -math.rad(extraAngle) * (1 - math.abs(look.Y)))
				
