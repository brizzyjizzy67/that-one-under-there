							if inst:IsA("BasePart") then
								inst.Transparency = 1 - ((1 - inst:GetAttribute("Transparency")) * trans)
								if trans ~= 0 then
									inst.CanQuery = inst:GetAttribute("CanQuery")
								else
									inst.CanQuery = false
								end
							end
						end
						task.wait()
					end
				end)
			end
        end
		return returnlist
	end

