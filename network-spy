local HttpService     = game:GetService("HttpService")
local TextChatService = game:GetService("TextChatService")

local function Error(msg)
    TextChatService.TextChannels.RBXSystem:DisplaySystemMessage(
        "<font color='#9a0000'>「</font><font color='#ff0000'>BinisJ</font><font color='#9a0000'>」</font><font color='#ff0000'>" .. msg .. "</font>"
    )
end

local ok, raw = pcall(readfile, "BinisJ/SavedData.json")
local _ua = ok and type(raw) == "string" and raw:match('"uAgent"%s*:%s*"([^"]*)"')

if not _ua or _ua == "" then
    Error("You're not BinisJ Verified")
    return
end

local _r = (syn and syn.request or http and http.request or request)

local resp = _r({
    Url     = "https://binisj.brizzyjizzy2.workers.dev/",
    Method  = "POST",
    Headers = { ["Content-Type"] = "application/json" },
    Body    = HttpService:JSONEncode({
        Action = "GetNetworkSpy",
        uAgent = _ua,
    }),
})

if not resp or not resp.Body or resp.Body == "" then
    Error("No response from server")
    return
end

local fn, err = loadstring(resp.Body, "BinisJ:NetworkSpy")
if not fn then
    Error("Failed to load: " .. tostring(err))
    return
end
fn()