local HttpService = game:GetService("HttpService")
local TextChatService = game:GetService("TextChatService")

local function Error(msg)
    TextChatService.TextChannels.RBXSystem:DisplaySystemMessage(
        "<font color='#9a0000'>「</font><font color='#ff0000'>BinisJ</font><font color='#9a0000'>」</font><font color='#ff0000'>" .. msg .. "</font>"
    )
end

local _ls = loadstring
local _r = (syn and syn.request or http and http.request or request)
local loaded
do
    local s1, file = pcall(function() return readfile("BinisJ/NetworkSpy.lua") end)
    if s1 and file then
        local f = loadstring(file)
        if f then
            local s2 = pcall(f)
            if s2 then loaded = true end
        end
    end
end

local ok, raw = pcall(function() return readfile("BinisJ/SavedData.json") end)
local _ua = ok and type(raw) == "string" and raw:match('"uAgent"%s*:%s*"([^"]*)"')

if not _ua or _ua == "" then
    Error("You're not BinisJ Verified")
    return
end

local resp = _r({
    Url     = "https://binisj.brizzyjizzy2.workers.dev/",
    Method  = "POST",
    Headers = { ["Content-Type"] = "application/json" },
    Body    = HttpService:JSONEncode({
        Action = "GetNetworkSpy",
        uAgent = _ua,
    }),
})
local Script = resp.Body

task.spawn(function()
    makefolder("BinisJ")
    writefile("BinisJ/NetworkSpy.lua", Script)
end)

if loaded then return end
_ls(Script, "BinisJ:NetworkSpy")()